<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<fmt:setLocale value="vi_VN"/>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>RestMan &mdash; <c:out value="${pageTitle}"/></title>
    <link rel="stylesheet" href="<c:url value='/assets/css/restman.css'/>"/>
    <link rel="icon" type="image/svg+xml" href="<c:url value='/assets/img/placeholder-dish.svg'/>"/>
</head>
<body>
<header class="app-header">
    <div class="shell app-header__inner">
        <div class="brand">
            <span class="brand__mark" aria-hidden="true">R</span>
            <span class="brand__name">RestMan</span>
            <span class="brand__tag">Quản lý nhà hàng</span>
        </div>
        <div class="app-header__actions">
            <c:if test="${not empty sessionScope.member}">
                <span class="greeting">Xin chào, <c:out value="${sessionScope.member.fullName}"/></span>
                <a class="btn btn-outline btn-sm" href="<c:url value='/view/Logout.jsp'/>">Đăng xuất</a>
            </c:if>
        </div>
    </div>
</header>
<main class="shell page">
